# ─────────────────────────────────────────
#  NetMon - Environment Configuration
# ─────────────────────────────────────────

# App
APP_PORT=3000
APP_ENV=development
JWT_SECRET=ganti_ini_dengan_string_random_panjang_minimal_32_karakter

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password_mysql_kamu
MYSQL_DBNAME=netmon

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DBNAME=netmon

# Browser Web Push
# Isi dengan key tetap untuk production. Jika kosong, backend akan generate key sementara saat start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@netmon.local

# ─── Default Users (dibuat otomatis saat pertama running) ───

# Admin - akses penuh
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@netmon.local
DEFAULT_ADMIN_PASSWORD=Admin@123!

# Atasan - bisa lihat semua, manage feedback
DEFAULT_ATASAN_USERNAME=atasan01
DEFAULT_ATASAN_EMAIL=atasan@netmon.local
DEFAULT_ATASAN_PASSWORD=Atasan@123!

# Teknisi IT - bisa ping, snmp, buat & lihat feedback
DEFAULT_TEKNISI_USERNAME=teknisi01
DEFAULT_TEKNISI_EMAIL=teknisi@netmon.local
DEFAULT_TEKNISI_PASSWORD=Teknisi@123!

# Staff - bisa buat & lihat feedback
DEFAULT_STAFF_USERNAME=staff01
DEFAULT_STAFF_EMAIL=staff@netmon.local
DEFAULT_STAFF_PASSWORD=Staff@123!

# Karyawan - hanya bisa buat laporan/keluhan
DEFAULT_KARYAWAN_USERNAME=karyawan01
DEFAULT_KARYAWAN_EMAIL=karyawan@netmon.local
DEFAULT_KARYAWAN_PASSWORD=Karyawan@123!
